{
  "name": "gsm.dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Executive dashboard components and app shell for the gsm ecosystem",
  "license": "Apache-2.0",
  "author": "Gilead Sciences",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gilead-Public/gsm.dash.git"
  },
  "scripts": {
    "build:reports": "npm run generate-data && astro build && node scripts/package-reports.mjs dist/reports",
    "test": "vitest run",
    "generate-data": "node scripts/generate-example-data.mjs",
    "e2e": "node validation/run.js --offline",
    "validate": "node validation/run.js",
    "criteria:sync": "node validation/sync-criteria.js",
    "typecheck": "tsc --noEmit",
    "criteria:review": "node validation/review-criteria.js"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.8",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.11",
    "es-module-lexer": "^3.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
