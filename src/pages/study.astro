---
// gsm.viz ships as a classic script that defines window.gsmViz; it runs inline before the module that mounts the page.
import { readFileSync } from 'node:fs';
import '../app/app.css';

const vendor = (file: string) => readFileSync(`public/vendor/gsm.viz-2.3.0/${file}`, 'utf8');
const vizCss = vendor('main.css');
const vizJs = vendor('index.js').replace(/<\/script/gi, '<\\/script');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>gsm.dash study report</title>
    <style is:inline set:html={vizCss}></style>
  </head>
  <body>
    <script is:inline type="application/json" id="gsm-data">__GSM_DATA__</script>
    <!-- The app's page shell, minus what belongs to the portfolio (study count, change log, back link). -->
    <div class="wrap">
      <header class="app">
        <h1>gsm.dash</h1>
        <span class="tag" id="page-tag">Study view</span>
        <span id="meta" class="muted"></span>
        <button type="button" class="hbtn" id="glossaryBtn" title="Open the CTQ metric glossary">Metric glossary</button>
        <div class="seg theme" id="themeSeg" role="group" aria-label="Theme">
          <button type="button" data-theme-pref="auto" class="on">Auto</button><button type="button" data-theme-pref="light">Light</button><button type="button" data-theme-pref="dark">Dark</button>
        </div>
      </header>
      <main id="app"></main>
    </div>
    <script is:inline set:html={vizJs}></script>
    <script>
      import { mount } from '../react/mount.jsx';
      mount(document.getElementById('app'));
    </script>
  </body>
</html>
