{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilead-public.github.io/gsm.dash/schemas/study-document.schema.json",
  "title": "gsm.dash study report data",
  "description": "Everything one study report shows, injected into the report after the build: the metric catalog, the study's manifest entry and all its snapshots.",
  "type": "object",
  "required": ["schemaVersion", "generated", "metrics", "study", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated": { "type": "string", "format": "date-time" },
    "reportBase": { "$ref": "portfolio.schema.json#/properties/reportBase" },
    "metrics": { "$ref": "portfolio.schema.json#/properties/metrics" },
    "study": {
      "type": "object",
      "required": ["StudyID", "params", "snapshots"],
      "additionalProperties": false,
      "properties": {
        "StudyID": { "type": "string", "minLength": 1 },
        "params": { "$ref": "portfolio.schema.json#/properties/studies/items/properties/params" },
        "snapshots": { "$ref": "portfolio.schema.json#/properties/studies/items/properties/snapshots" }
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "study-snapshot.schema.json" }
    }
  }
}
