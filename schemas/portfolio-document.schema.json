{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilead-public.github.io/gsm.dash/schemas/portfolio-document.schema.json",
  "title": "gsm.dash portfolio report data",
  "description": "Everything the portfolio report shows, injected into the report after the build: the metric catalog, each study's manifest entry without its file list, and the counts-only portfolio summary. It carries no per-study snapshot files.",
  "type": "object",
  "required": ["schemaVersion", "generated", "metrics", "studies", "summary"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated": { "type": "string", "format": "date-time" },
    "reportBase": { "$ref": "portfolio.schema.json#/properties/reportBase" },
    "metrics": { "$ref": "portfolio.schema.json#/properties/metrics" },
    "studies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["StudyID", "params", "snapshots"],
        "additionalProperties": false,
        "properties": {
          "StudyID": { "type": "string", "minLength": 1 },
          "params": { "$ref": "portfolio.schema.json#/properties/studies/items/properties/params" },
          "snapshots": { "$ref": "portfolio.schema.json#/properties/studies/items/properties/snapshots" }
        }
      }
    },
    "summary": { "$ref": "portfolio-summary.schema.json" }
  }
}
