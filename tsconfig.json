{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["validation/**/*.js", "e2e/**/*.js", "playwright.config.js", "src/react/**/*", "scripts/inject.mjs", "scripts/package-reports.mjs", "scripts/study-document.mjs"]
}
