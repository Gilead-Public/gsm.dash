          "kind": "e2e",
          "reviewed": false
        },
        {
          "id": "10.05",
          "text": "There's no total row that repeats the header value.",
          "sha256": "7c6650c30d4db5a07d019b0a725e45b17d7a415ad1e987276651c1f04e51f1ff",
          "kind": "e2e",
          "reviewed": false
        },
        {
          "id": "10.06",
          "text": "Status colours come from configuration, and the neutral fallback applies when none are given (test).",
          "sha256": "b6a077ef4151e1f3c0b674bb67ed8827e739bdee8a7483c643bd6c8bd163132e",
          "kind": "e2e",
          "reviewed": false
        },
        {
          "id": "10.07",
          "text": "Sorting, top-N collapsing, \"Not recorded\" placement, the footnotes, and the empty and missing states are tested.",
          "sha256": "f3df7a10bcc0f5528d8769189d395745e34316f406021c4c50c712647f478dd7",
          "kind": "e2e",
          "reviewed": false
        },
        {
          "id": "10.08",
          "text": "A reviewer compares the rendered widget with the Layout A design and accepts it (visual comparison).",
          "sha256": "08e58e24ea3af4caafd63b6bba6f16850456cd7408033e3dfa1f5d87e0c4ec18",
          "kind": "visual",
          "reviewed": false
