  "issues": [
    {
      "number": 8,
      "title": "Add a distributions layer to the study snapshot contract",
      "parent": "Gilead-BioStats/gsm.roadmap#625",
      "userTest": false,
      "criteria": [
        {
          "id": "8.01",
          "text": "The schema accepts a valid `distributions` array. It rejects missing required columns, a `Source` outside `Numerator`/`Denominator`, negative counts, and a `Percent` outside 0–1.",
          "sha256": "3ba41e1c846f21dabe7994778070f3ccf72c8b3877e8cc23b93ec5cd790c0359",
          "kind": "unit",
          "reviewed": false
        },
        {
          "id": "8.02",
          "text": "A study file without `distributions` stays valid, because metrics without distributions are unaffected.",
          "sha256": "6a85d30b5c8ccffa1caca634b27482ded64e4c1ad82811ca9678999d30f10a84",
          "kind": "unit",
          "reviewed": false
        },
        {
          "id": "8.03",
          "text": "Contract tests cover the valid, invalid and empty cases.",
          "sha256": "4860fcea5e62463a57b256d134248995a84ff388b337b818c4a3213f2a049255",
          "kind": "unit",
          "reviewed": false
        }
      ]
    },
    {
      "number": 9,
      "title": "Generate simulated distributions for the #617 metrics",
      "parent": "Gilead-BioStats/gsm.roadmap#625",
      "userTest": false,
      "criteria": [
        {
          "id": "9.01",
          "text": "On the fixture, for numerator distributions, `Total` equals the metric's Numerator (per metric × group). This is a gsm.roadmap#617 acceptance check.",
          "sha256": "28c46062dc5b96c66a3bdd21e028b940c89a095172dad224611848732fe90749",
          "kind": "unit",
          "reviewed": false
        },
        {
          "id": "9.02",
          "text": "On the fixture, for denominator distributions, `Total` equals the metric's Denominator. This is a gsm.roadmap#617 acceptance check.",
          "sha256": "3b2c50e17aca7891902b3ab491faa59704377becc786ce251b38c3ffe0f3c7c6",
          "kind": "unit",
          "reviewed": false
        },
        {
          "id": "9.03",
          "text": "On the fixture, for single-value variables, the sum of `Count` over categories equals `Total`. This is a gsm.roadmap#617 acceptance check.",
          "sha256": "be8b009fcad351729421e06b11b69c135e271087499f7ebe6e00deaf2d013ceb",
          "kind": "unit",
          "reviewed": false
        },
        {
          "id": "9.04",
          "text": "In each study's latest snapshot, every site in `results` for a configured metric has distribution rows.",
          "sha256": "cadf993ecf71f1e364f8fbbdf2e3892a070e15bfe132720c21b56df42ff5b927",
          "kind": "unit",
          "reviewed": false
        },
        {
          "id": "9.05",
          "text": "The generated files validate against the #8 schema.",
          "sha256": "b916b84a0b3fb53e9132fad27a5b69c4b0e21d9cb05fcd7b29e1b616e82b233b",
          "kind": "unit",
          "reviewed": false
        }
      ]
    },
    {
      "number": 10,
      "title": "Build a Layout A bar-chart distribution widget",
      "parent": "Gilead-BioStats/gsm.roadmap#618",
      "userTest": true,
      "criteria": [
        {
          "id": "10.01",
          "text": "The widget renders from the #9 fixture for every configured metric.",
          "sha256": "34d7f5eda43dd37e6f85ffd7d293662228dad2abfc0a652d894975993a43d892",
          "kind": "e2e",
          "reviewed": false
        },
        {
          "id": "10.02",
          "text": "Displayed counts and both percentages equal independently summed fixture values (test).",
          "sha256": "884335495d383eb2244d42c3242e61676bd7bca0298f2c770f0ade3af9fc45f4",
          "kind": "e2e",
          "reviewed": false
        },
        {
          "id": "10.03",
          "text": "The site-to-study summing sits in one tested function, so it can be qualified as dashboard logic (gsm.roadmap#625).",
